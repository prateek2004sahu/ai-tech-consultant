# ---- Choose ONE provider (get a free Gemini key at https://aistudio.google.com/apikey) ----
LLM_PROVIDER=gemini            # gemini | openai | anthropic | mock (mock = offline smoke tests only)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# EMBED_PROVIDER=gemini        # needed when LLM_PROVIDER=anthropic (Claude has no embeddings API)
# LLM_MODEL=                   # override default chat model, e.g. for model comparison evals
# PRICE_IN_PER_M=0.30          # USD per 1M input tokens of YOUR model (for cost in evals)
# PRICE_OUT_PER_M=2.50

SITEMAP_URL=https://support.brilliantdirectories.com/support/sitemap.xml
CRAWL_DELAY=1.0                # seconds between requests (global)
CRAWL_CONCURRENCY=2
MAX_IMAGES_PER_PAGE=6
MIN_SCORE=0.35                 # tune using evaluation/run_eval.py
DAILY_HOUR=2                   # daily sitemap check (server local time)
ENABLE_SCHEDULER=1
# KB_API_KEY=                  # if set, clients must send X-API-Key
