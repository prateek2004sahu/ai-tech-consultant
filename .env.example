# Copy to .env (run.sh does this for you), then paste ONE API key.
# Free Gemini key: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini            # gemini | openai | anthropic | mock (mock = offline smoke test only)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# EMBED_PROVIDER=gemini        # required when LLM_PROVIDER=anthropic (Claude has no embeddings API)
# LLM_MODEL=                   # override the chat model (use this to compare models in evals)
# PRICE_IN_PER_M=0.30          # USD per 1M input tokens of your model -> real cost numbers in evals
# PRICE_OUT_PER_M=2.50

# Task 1
SITEMAP_URL=https://support.brilliantdirectories.com/support/sitemap.xml
CRAWL_DELAY=1.0
CRAWL_CONCURRENCY=2
MAX_IMAGES_PER_PAGE=6
MIN_SCORE=0.35
ENABLE_SCHEDULER=1
DAILY_HOUR=2
# KB_API_KEY=

# Tasks 2 and 3 -> Task 1
KB_URL=http://localhost:8001

# Task 2
AUTONOMY_THRESHOLD=20
AUDIT_EVERY=5
# Task 3
HOURLY_RATE=50
CURRENCY=USD
CONTINGENCY_PCT=15
HOURS_PER_WEEK=30
